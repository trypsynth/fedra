[Setup]
	AppName=Fedra
	AppVersion=@PROJECT_VERSION@
	AppPublisher=Quin Gillespie
	AppPublisherURL=https://github.com/trypsynth/fedra
	AppSupportURL=https://github.com/trypsynth/fedra/issues
	AppUpdatesURL=https://github.com/trypsynth/fedra/releases
	DefaultDirName={autopf}\Fedra
	DisableProgramGroupPage=yes
	DisableDirPage=yes
	LicenseFile=
	OutputDir=.
	OutputBaseFilename=fedra_setup-@ARCH_SUFFIX@
	Compression=lzma2
	SolidCompression=yes
	WizardStyle=modern
	UninstallDisplayIcon={app}\fedra.exe
	ArchitecturesAllowed=@ARCH_ISS@
	ArchitecturesInstallIn64BitMode=@ARCH_ISS@

[Languages]
	Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
	Source: "fedra.exe"; DestDir: "{app}"; Flags: ignoreversion
	Source: "readme.html"; DestDir: "{app}"; Flags: ignoreversion

[InstallDelete]
	Type: filesandordirs; Name: "{app}\sounds"

[Tasks]
	Name: "desktopicon"; Description: "Desktop Shortcut"
	Name: "startmenuicon"; Description: "Start Menu Shortcut"; Flags: unchecked
	Name: "startup"; Description: "Run at startup"; Flags: unchecked

[Icons]
	Name: "{autodesktop}\Fedra"; Filename: "{app}\fedra.exe"; Tasks: desktopicon
	Name: "{autoprograms}\Fedra"; Filename: "{app}\fedra.exe"; Tasks: startmenuicon

[Registry]
	Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "Fedra"; ValueData: """{app}\fedra.exe"" --startup"; Tasks: startup; Flags: uninsdeletevalue
	Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueName: "Fedra"; ValueType: none; Tasks: not startup; Flags: deletevalue dontcreatekey

[Run]
	Filename: "{app}\fedra.exe"; Description: "Launch Fedra"; Flags: nowait postinstall skipifsilent
	Filename: "{app}\readme.html"; Description: "View readme.html"; Flags: shellexec postinstall skipifsilent unchecked
